# Copie este arquivo para ".env" (cp .env.example .env) e preencha com os dados do SEU banco no Neon (Connection Details no painel do Neon).
# O arquivo .env nunca vai para o Git (tem senha!).
DB_HOST=ep-SEU-ENDPOINT.REGIAO.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=sua-senha
DB_SSLMODE=require

# Chave combinada com o backend (ETL_KEY no backend/.env). Vazio = sem chave (só para estudar no seu computador).
ETL_API_KEY=
