# Copie este arquivo para ".env" (cp .env.example .env) e preencha. O .env nunca vai para o Git (tem senha!).

# Forma 1 (mais simples): a string do Neon, do jeito que ele mostra em "Connect" (a SEM "-pooler")
DATABASE_URL=postgresql://neondb_owner:sua-senha@ep-SEU-ENDPOINT.REGIAO.aws.neon.tech/neondb?sslmode=require

# Forma 2: os dados separados (só é usada se DATABASE_URL estiver vazia)
# DB_HOST=ep-SEU-ENDPOINT.REGIAO.aws.neon.tech
# DB_PORT=5432
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=sua-senha
# DB_SSLMODE=require

# Chave combinada com o backend (o Java manda no cabeçalho X-ETL-Key). Vazio = sem chave (só para estudar no seu computador).
ETL_API_KEY=
