# Banco local (padrão). Para usar o banco do grupo no Neon, troque pelo formato:
# DB_URL=jdbc:postgresql://ep-SEU-ENDPOINT-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DB_USER=neondb_owner
# A senha vai só em DB_PASSWORD, nunca dentro da URL nem no application.properties.
DB_URL=jdbc:postgresql://localhost:5432/cti_insights
DB_USER=
DB_PASSWORD=
ETL_URL=http://localhost:8000
ETL_API_KEY=
ETL_CONNECT_TIMEOUT=3s
ETL_READ_TIMEOUT=60s
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Somente para desenvolvimento via HTTP local. Em HTTPS mantenha true.
SESSION_COOKIE_SECURE=true
# Origem HTTPS real do frontend Vercel, sem /api e sem barra final.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Chamadas diretas entre sites: none + SESSION_COOKIE_SECURE=true; cookies de terceiros podem ser bloqueados.
# Preferir proxy /api na mesma origem quando possível.
SESSION_COOKIE_SAME_SITE=lax
