# Copie para .env e ajuste. O arquivo .env não vai para o Git.

# true (padrão): dados e login simulados no navegador (localStorage).
# false: usa a API real definida abaixo.
VITE_USE_MOCK=true

# Base da API (usada só com VITE_USE_MOCK=false).
# Com o proxy do Vite (veja vite.config.js), "/api" evita problemas de CORS
# em desenvolvimento. Em produção, use a URL completa do back-end.
VITE_API_URL=/api
